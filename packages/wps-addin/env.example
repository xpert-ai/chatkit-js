PORT=8789
ADDIN_BASE_URL=http://localhost:3003

# Frontend mode. Use user-api-key for no local session proxy, or proxy for /api/create-session.
VITE_CHATKIT_SESSION_MODE=user-api-key

# Used by dist/config.js or VITE_* build-time defaults in user-api-key mode.
VITE_XPERTAI_API_URL=https://api.xpertai.cn/api/ai
VITE_XPERTAI_XPERT_ID=your-xpert-id
VITE_XPERTAI_CHATKIT_FRAME_URL=https://app.xpertai.cn/chatkit/index.html

# Server proxy mode only. Do not expose this through VITE_* in a shared build.
XPERTAI_API_URL=https://api.xpertai.cn/api/ai
XPERTAI_API_KEY=sk-x-your-api-key
XPERTAI_XPERT_ID=your-xpert-id
XPERTAI_CHATKIT_FRAME_URL=https://app.xpertai.cn/chatkit/index.html
# XPERTAI_ORGANIZATION_ID=org-xxx
# XPERTAI_PRINCIPAL_USER_ID=user-xxx
# XPERTAI_CLIENT_SECRET_EXPIRES_AFTER=600
