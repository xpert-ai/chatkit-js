{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@xpert-ai/a2ui-react": [
        "../chatkit-widgets/src/index.ts"
      ],
      "@xpert-ai/chatkit-types": [
        "../chatkit/src/index.ts"
      ],
      "@xpert-ai/chatkit-web-shared": [
        "../chatkit-web-shared/src/index.ts"
      ],
      "@xpert-ai/chatkit-primitives": [
        "../chatkit-primitives/src/index.ts"
      ],
      "@xpert-ai/chatkit-primitives/*": [
        "../chatkit-primitives/src/*"
      ],
      "@xpert-ai/chatkit-primitives/lib/*": [
        "../chatkit-primitives/src/lib/*"
      ]
    },
    "jsx": "react-jsx",
    "outDir": "dist",
    "rootDir": "..",
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "widget-preview/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
